    public GameView(Context context) {
        super(context);
        setKeepScreenOn(true);
        prefs = context.getSharedPreferences("tower_bugs_progress_v2", Context.MODE_PRIVATE);
        level = Math.max(1, prefs.getInt("level", 1));
        bugBucks = prefs.getInt("bug_bucks", 0);
        startCoinUpgrade = prefs.getInt("start_coin_upgrade", 0);
        freeBlockUpgrade = prefs.getInt("free_block_upgrade", 0);
        bugPowerUpgrade = prefs.getInt("bug_power_upgrade", 0);

        for (int i = 0; i < homeBugCards.length; i++) {
            homeBugCards[i] = new RectF();
            shopBugCards[i] = new RectF();
        }

        stroke.setStyle(Paint.Style.STROKE);
        stroke.setStrokeWidth(2f);
        stroke.setColor(Color.argb(130, 230, 225, 205));
        loadSprites();
    }

    private void loadSprites() {
        Map<String, Bitmap> assets = loadAssetZip("game_assets.zip");
        floorSprite = assets.get("floor_greystone.webp");
        wallIntactSprite = assets.get("wall_intact.webp");
        wallCrackedSprite = assets.get("wall_cracked.webp");
        wallRubbleSprite = assets.get("wall_rubble.webp");
        towerSprite = assets.get("tower.webp");

        for (BugType type : BugType.values()) {
            bugSprites.put(type, new Bitmap[]{assets.get(type.level1Asset), assets.get(type.level2Asset)});
        }
        frogSprites.put(FrogColor.YELLOW, assets.get("frog_yellow.webp"));
        frogSprites.put(FrogColor.GREEN, assets.get("frog_green.webp"));
        frogSprites.put(FrogColor.BLUE, assets.get("frog_blue.webp"));
        frogSprites.put(FrogColor.RED, assets.get("frog_red.webp"));

        armorBody[1] = assets.get("armor_body_1.webp");
        armorBody[2] = assets.get("armor_body_2.webp");
        armorBody[3] = assets.get("armor_body_3.webp");
        armorHead[1] = assets.get("armor_head_1.webp");
        armorHead[2] = assets.get("armor_head_2.webp");
        armorHead[3] = assets.get("armor_head_3.webp");
    }

    private Map<String, Bitmap> loadAssetZip(String assetName) {
        Map<String, Bitmap> result = new HashMap<>();
        try (InputStream raw = getContext().getAssets().open(assetName); ZipInputStream zin = new ZipInputStream(raw)) {
            ZipEntry entry;
            byte[] buffer = new byte[16384];
            while ((entry = zin.getNextEntry()) != null) {
                if (entry.isDirectory()) continue;
                ByteArrayOutputStream out = new ByteArrayOutputStream();
                int read;
                while ((read = zin.read(buffer)) > 0) out.write(buffer, 0, read);
                byte[] bytes = out.toByteArray();
                Bitmap bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.length);
                if (bitmap != null) result.put(entry.getName(), bitmap);
                zin.closeEntry();
            }
        } catch (IOException ignored) {
        }
        return result;
    }

    @Override
    protected void onDraw(Canvas canvas) {
        super.onDraw(canvas);
        long now = System.nanoTime();
        float dt = lastFrameNanos == 0 ? 0f : Math.min(0.05f, (now - lastFrameNanos) / 1_000_000_000f);
        lastFrameNanos = now;

        if (phase == Phase.WAVE || phase == Phase.INTERMISSION) updateGame(dt);

        canvas.drawColor(Color.rgb(17, 20, 17));
        if (phase == Phase.HOME) {
            drawHome(canvas);
        } else {
            calculateBoardGeometry();
            drawHud(canvas);
            drawBoard(canvas);
            drawBottomControls(canvas);
            if (bugShopOpen) drawBugShop(canvas);
            if (bugPanelOpen) drawBugPanel(canvas);
            if (phase == Phase.LEVEL_COMPLETE) drawEndOverlay(canvas, true);
            if (phase == Phase.GAME_OVER) drawEndOverlay(canvas, false);
        }
        postInvalidateOnAnimation();
    }

    private void calculateBoardGeometry() {
        float topHud = Math.max(64f, getHeight() * 0.095f);
        float bottomHud = Math.max(92f, getHeight() * 0.145f);
        float usableH = Math.max(1f, getHeight() - topHud - bottomHud);
        cell = Math.min(getWidth() / (float) COLS, usableH / ROWS);
        boardLeft = (getWidth() - cell * COLS) / 2f;
        boardTop = topHud + (usableH - cell * ROWS) / 2f;
    }

    private void drawHome(Canvas c) {
        float h = getHeight();
        float w = getWidth();
        paint.setTextAlign(Paint.Align.CENTER);
        paint.setColor(Color.rgb(244, 218, 119));
        paint.setTextSize(Math.max(28f, h * 0.055f));
        paint.setFakeBoldText(true);
        c.drawText("TOWER BUGS: FROG DEFENSE", w / 2f, h * 0.07f, paint);